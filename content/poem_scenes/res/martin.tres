[resource]
script = ExtResource("1_a5omb")
lines = Array[String](["No quiero cambiar.
Mi lógica cíclica me envuelve y me atrapa.", "Avanzar me retrasa.
Pero me reconfortan mis pasos.
Me retraso y no avanzo.", "Mi lógica cíclica me envuelve y me atrapa.
No quiero cambiar?"])
